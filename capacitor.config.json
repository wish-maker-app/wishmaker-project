{
  "appId": "fr.wishmaker.app",
  "appName": "Wish Maker",
  "webDir": "dist",
  "plugins": {
    "Keyboard": {
      "resize": "native",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "launchAutoHide": true,
      "backgroundColor": "#5B6BF5",
      "showSpinner": false
    },
    "SocialLogin": {
      "providers": {
        "google": true,
        "apple": true,
        "facebook": false,
        "twitter": false
      }
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "ios": {
    "backgroundColor": "#ffffff"
  }
}
